{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kuriume",
  "version": "../package.json",
  "identifier": "com.twac.kuriume",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kuriume",
        "width": 1440,
        "height": 960,
        "minWidth": 1080,
        "minHeight": 720,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "'self' ipc: http://ipc.localhost kuriume-media: http://kuriume-media.localhost https: http:",
        "img-src": "'self' asset: http://asset.localhost https: data:",
        "media-src": "'self' asset: http://asset.localhost kuriume-media: http://kuriume-media.localhost https: http: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
